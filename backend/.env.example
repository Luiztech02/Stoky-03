# Copie este arquivo para ".env" e ajuste os valores conforme necessário.

# Banco de dados. Padrão: SQLite local (arquivo stocksys.db).
# Para PostgreSQL: postgresql://usuario:senha@localhost:5432/stocksys
DATABASE_URL=sqlite:///./stocksys.db

# Chave usada para assinar os tokens JWT. TROQUE em produção.
# Gere uma nova com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave-em-producao

# Tempo de expiração do token de acesso, em minutos.
ACCESS_TOKEN_EXPIRE_MINUTES=480
